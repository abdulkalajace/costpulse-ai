# Postgres connection string. Locally: postgresql://postgres:postgres@localhost:5432/costpulse
# On Railway/Render/Supabase/Neon, copy the connection string they give you.
DATABASE_URL="postgresql://user:password@localhost:5432/costpulse"

# Random long secret used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

NODE_ENV="development"

# Optional. If set, AI features (cost audits, chat analyst, executive
# reports, receipt OCR) call Google Gemini for real. If unset, the app runs
# on deterministic, data-driven fallback logic instead — the app is fully
# functional either way.
# GEMINI_API_KEY=""
